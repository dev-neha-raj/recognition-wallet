<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-wallets" author="recognition-wallet">

        <createTable tableName="wallets">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="employee_id" type="VARCHAR(64)">
                <constraints
                    unique="true"
                    uniqueConstraintName="uq_wallets_employee_id"
                    nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- Nullable: populated only when a wallet is closed -->
            <column name="closed_at" type="TIMESTAMP WITH TIME ZONE"/>

            <column name="closed_reason" type="VARCHAR(255)"/>

        </createTable>

    </changeSet>

</databaseChangeLog>